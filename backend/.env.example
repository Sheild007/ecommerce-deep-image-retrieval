# ─── Neon PostgreSQL (pgvector) ───────────────────────────────────────────────
# Get from: https://console.neon.tech → Your Project → Connection Details
# Use the POOLER connection string for best performance on serverless/HF Spaces
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-xxxx.region.aws.neon.tech/neondb?sslmode=require

# ─── Server ───────────────────────────────────────────────────────────────────
# Hugging Face Spaces sets PORT=7860 automatically; only needed for local dev
PORT=7860
